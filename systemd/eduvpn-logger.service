[Unit]
Description=eduVPN correlated log (vpn-user-portal + proxyguard + WireGuard)
After=network.target apache2.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/eduvpn-logger.py
Restart=always
RestartSec=2

# Runs as root, but contained. It only needs: CAP_NET_ADMIN for `wg show`, and
# CAP_DAC_READ_SEARCH + CAP_DAC_OVERRIDE to open the portal DB (www-data, 0600)
# read-only — OVERRIDE because a read-only reader of a WAL-mode SQLite DB must
# still create its -shm file. Verified by e2e_test.sh.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
# New files (the log) are 0640: they hold personal data.
UMask=0027
# /var/lib/eduvpn-logger: journald cursor, so portal events logged while the
# daemon is down are replayed on start (EDUVPN_STATE_DIR).
StateDirectory=eduvpn-logger
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Optional overrides (defaults shown). Do not edit this file — it is replaced
# on re-install. Use `sudo systemctl edit eduvpn-logger` and put the lines you
# need under [Service] in the drop-in.
#Environment=EDUVPN_LOG=/var/log/eduvpn/eduvpn.log
#Environment=EDUVPN_PORTAL_DB=/var/lib/vpn-user-portal/db.sqlite
#Environment=EDUVPN_PROXYGUARD_START_LOG=/var/log/apache2/proxyguard_start.log
#Environment=EDUVPN_GEOIP_DB=/usr/local/share/GeoIP/GeoLite2-City.mmdb
#Environment=EDUVPN_GEOIP_LANG=en
#Environment=EDUVPN_SYSLOG_IDENT=eduvpn-logger
#Environment=EDUVPN_SYSLOG_FACILITY=local0
#Environment=EDUVPN_WG_POLL_SEC=2.0
#Environment=EDUVPN_DISCONNECT_AFTER_SEC=180.0
#Environment=EDUVPN_CONNECT_GRACE_SEC=10.0
#Environment=EDUVPN_ROAM_MIN_INTERVAL_SEC=30.0
#Environment=EDUVPN_STATE_DIR=/var/lib/eduvpn-logger

[Install]
WantedBy=multi-user.target
